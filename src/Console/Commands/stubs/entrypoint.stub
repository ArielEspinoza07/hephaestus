#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloadCandidates = [
        dirname(__DIR__) . '/vendor/autoload.php',
        dirname(__DIR__, 3) . '/autoload.php',
];

$autoloader = null;

foreach ($autoloadCandidates as $candidate) {
    if (is_file($candidate)) {
        $autoloader = $candidate;
        break;
    }
}

if ($autoloader === null) {
    fwrite(STDERR, "Unable to locate Composer's autoload.php. Run \"composer install\".\n");
    exit(1);
}

require_once $autoloader;


use Hephaestus\CliApp;

exit(
    CliApp::create('{{ appName }}', '{{ version }}')
        ->registerCommandsDirectory(__DIR__ . '/../{{ commandsDir }}')
        ->run()
);
